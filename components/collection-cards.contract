use Collection from "../shapes.contract"

// A square cover and two lines: one card on a horizontal shelf.
component ShelfCard
  props
    item: Collection
    href: string
    cardId: string
  view
    link href=href testId=cardId width=148 padding-right=12 box-sizing="content-box" flex-shrink=0 text-decoration="none" color="text.primary"
      column gap=6
        image item.cover width=148 height=148 border-radius=8 object-fit="cover" alt=""
        text item.title font-size="min(-exact-subheadline, 18px)" font-weight=600 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text item.subtitle font-size="min(-exact-caption1, 14px)" color="text.muted" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// A compact cover-and-title tile for the two-column grid at the top of Home.
component QuickTile
  props
    item: Collection
    href: string
    tileId: string
  view
    link href=href testId=tileId flex="1 1 160px" min-width=0 display="flex" flex-direction="row" align-items="center" gap=10
      background-color="surface.card" border-radius=6 overflow="hidden" text-decoration="none" color="text.primary"
      image item.cover width=52 height=52 flex-shrink=0 object-fit="cover" alt=""
      text item.title font-weight=600 flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" padding-right=8
